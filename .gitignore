coverage/

# ── Payload CMS uploaded media ────────────────────────────────
# Static media files that were pre-seeded are tracked.
# Only ignore temp/large uploads that shouldn't be in git.
# web/media/ is intentionally NOT ignored — seeded images must deploy with the app.
web/media/*.tmp

# ── Source PDFs at repo root (stored in docs/source-files/ instead) ───────────
/Website-profile.pdf

# ── Temporary design reference images — delete folder when done ───────────────
web/public/temp-bg-color-chooice-imgs/
