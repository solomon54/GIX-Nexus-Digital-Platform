# ──────────────────────────────────────────────────────────────────
# GIX Nexus Digital Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────

# Database — Source: DEC-001 (PostgreSQL confirmed)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://user:password@localhost:5432/gix_nexus_platform

# Payload CMS Secret
# Must be a long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-here-change-in-production

# App URL
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────
# OPEN QUESTION OQ-108: Hosting not yet decided
# The following variables are required when hosting is confirmed.
# Update these when deployment target is selected.
# ──────────────────────────────────────────────────────────────────

# Production app URL (update when hosting is confirmed)
# NEXT_PUBLIC_APP_URL=https://www.gixnexus.com

# PostgreSQL connection (production — update when hosting is confirmed)
# DATABASE_URL=postgresql://...

# Node environment
NODE_ENV=development
